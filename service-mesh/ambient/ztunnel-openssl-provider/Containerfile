# Test image: the ztunnel image your mesh already runs, with only the ztunnel
# binary replaced by one built from the same source plus the patches in this
# directory.
#
# Stage 1 builds ztunnel on UBI 9 with the same cargo command as the downstream
# CI (ossm/ci/pre-submit.sh in openshift-service-mesh/ztunnel):
# --no-default-features --features <backend>. The OSSM image uses tls-openssl,
# linked against the RHEL OpenSSL. The other backends (tls-aws-lc, tls-ring,
# tls-boring) carry their own crypto inside the binary.
#
# Stage 2 copies the binary over the original image, so for OpenSSL the
# libcrypto, the FIPS provider and its configuration stay exactly as Red Hat
# ships them.
#
# Use build-test-image.sh rather than building this by hand: it works out BASE,
# ZTUNNEL_PATH, the backend settings and the source commit, and checks the result.
# Build context: a checkout of the ztunnel source with the patches applied.

ARG BUILDER=registry.access.redhat.com/ubi9/ubi:latest
ARG BASE

FROM ${BUILDER} AS build
ARG RUST_TOOLCHAIN=stable
ARG PROTOC_VERSION=30.2
# Set by build-test-image.sh from BACKEND.
ARG BACKEND=openssl
ARG CARGO_FEATURE=tls-openssl
ARG BUILD_PACKAGES=openssl-devel
ARG MARKER=7ztunnel3tls3lib8PROVIDER

RUN dnf -y install gcc make git unzip pkgconf-pkg-config glibc-devel ${BUILD_PACKAGES} \
 && dnf clean all

# protoc: build.rs compiles the xDS protos.
RUN arch=$(uname -m) && case "$arch" in aarch64) arch=aarch_64 ;; esac \
 && curl -sSfL -o /tmp/protoc.zip \
      "https://github.com/protocolbuffers/protobuf/releases/download/v${PROTOC_VERSION}/protoc-${PROTOC_VERSION}-linux-${arch}.zip" \
 && unzip -q /tmp/protoc.zip -d /usr/local bin/protoc 'include/*' \
 && rm /tmp/protoc.zip

ENV RUSTUP_HOME=/opt/rustup CARGO_HOME=/opt/cargo PATH=/opt/cargo/bin:$PATH
RUN curl -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain ${RUST_TOOLCHAIN}

WORKDIR /src
COPY . .
RUN cargo build --release --no-default-features --features "${CARGO_FEATURE}"

# Fail the build unless the binary is what we want to test: it carries the
# patch, and an OpenSSL build is dynamically linked to the system libcrypto.
# The marker is part of a symbol name the patch adds, under both Rust
# symbol-mangling schemes, so a plain grep finds it without demangling.
RUN B=out/rust/release/ztunnel \
 && echo "backend: ${BACKEND} (--features ${CARGO_FEATURE})" \
 && grep -a -q "${MARKER}" "$B" \
 && if [ "${BACKEND}" = openssl ]; then \
      echo "builder: $(openssl version)" \
      && ldd "$B" | grep -E 'libssl|libcrypto' \
      && echo "rustls-openssl: $(grep -a -o 'rustls-openssl-0\.[0-9]*\.[0-9]*' "$B" | head -1)"; \
    fi \
 && cp "$B" /ztunnel

FROM ${BASE}
ARG ZTUNNEL_PATH=/usr/local/bin/ztunnel
COPY --from=build /ztunnel ${ZTUNNEL_PATH}
