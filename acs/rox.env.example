# Copy to rox.env (gitignored) so a new shell does not start by rediscovering
# all of this. Keep it mode 600: it holds a credential.
#
#   oc -n stackrox get route central -o jsonpath='{.spec.host}'
export ROX_CENTRAL_ADDRESS="central-stackrox.apps.example.com:443"

# Central presents the cluster ingress certificate once its defaultTLSSecret is
# patched (see README "Scan the two namespaces"); this is that CA:
#   oc -n openshift-ingress-operator get secret router-ca \
#     -o jsonpath='{.data.tls\.crt}' | base64 -d > router-ca.crt
export ROX_CA="router-ca.crt"

# One credential, not both. A token is shown once and cannot be read back; the
# admin password can:
#   oc -n stackrox get secret central-htpasswd -o jsonpath='{.data.password}' | base64 -d
export ROX_API_TOKEN="<paste-token>"
# export ROX_ADMIN_PASSWORD="<admin-password>"
