# NFS client utility image for the direct (in-pod) NFS mount test.
#
# The mount(8) call inside the pod execs /sbin/mount.nfs from the *container*
# image, so the image - not the Kata guest rootfs - has to provide nfs-utils.
# The nfs/nfsv4 kernel module still has to come from the Kata guest kernel.
#
# Build on any RHEL node with podman and push to the mirror registry:
#
#   export NFS_UTIL_IMAGE="<mirror_registry>/openshift_sandboxed_containers/ubi-nfs-util:latest"
#   podman build -t $NFS_UTIL_IMAGE -f Containerfile .
#   podman push $NFS_UTIL_IMAGE
#
ARG BASE_IMAGE=registry.access.redhat.com/ubi9/ubi:latest
FROM $BASE_IMAGE

# nfs-utils  -> mount.nfs, umount.nfs, nfsstat
# util-linux -> mount, findmnt
# kmod       -> modprobe/lsmod, to check guest kernel NFS support
# iputils    -> ping, for pod-network reachability checks
# nmap-ncat  -> nc, to test 2049/tcp from inside the Kata guest
RUN dnf -y install nfs-utils util-linux kmod iputils nmap-ncat \
    && dnf clean all \
    && rm -rf /var/cache/dnf

CMD ["/bin/bash"]
