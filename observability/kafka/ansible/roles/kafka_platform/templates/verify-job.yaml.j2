apiVersion: batch/v1
kind: Job
metadata:
  name: kafka-verify-topics
  namespace: {{ kafka_namespace }}
spec:
  backoffLimit: 1
  ttlSecondsAfterFinished: 3600
  template:
    metadata:
      labels:
        app: kafka-verify-topics
    spec:
      restartPolicy: Never
      containers:
        - name: kafka-offsets
          image: {{ kafka_admin_image }}
          command:
            - /bin/bash
            - -c
            - |
              set -o pipefail
              CFG=/etc/kafka-admin/client.properties
              BS={{ kafka_bootstrap_effective | join(',') }}
{% for t in kafka_topics if t.enabled | bool %}
              echo "==> {{ t.name }}"
              bin/kafka-get-offsets.sh --bootstrap-server "$BS" \
                --command-config "$CFG" --topic {{ t.name }} \
                | sed 's/^/    /'
{% endfor %}
              # kafka-get-offsets.sh prints `<topic>:<partition>:<end offset>`.
              # The end offset is the next offset that WILL be written, so a
              # non-zero value means records have landed - it does not tell you
              # whether anything has consumed them.
          volumeMounts:
            - name: admin-config
              mountPath: /etc/kafka-admin
              readOnly: true
{% if (kafka_tls_effective | bool) and not (kafka_tls_insecure_skip_verify | bool) %}
            - name: kafka-ca
              mountPath: /etc/kafka-ca
              readOnly: true
{% endif %}
          resources:
            requests:
              cpu: 100m
              memory: 256Mi
            limits:
              memory: 512Mi
          securityContext:
            allowPrivilegeEscalation: false
            runAsNonRoot: true
            capabilities:
              drop: ["ALL"]
            seccompProfile:
              type: RuntimeDefault
      volumes:
        - name: admin-config
          secret:
            secretName: kafka-admin-config
{% if (kafka_tls_effective | bool) and not (kafka_tls_insecure_skip_verify | bool) %}
        - name: kafka-ca
          secret:
            secretName: {{ kafka_ca_secret_name }}
{% endif %}
