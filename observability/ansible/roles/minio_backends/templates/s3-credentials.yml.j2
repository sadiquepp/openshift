# S3 backends for the OpenShift observability stack.
#
#   Generated by  observability/ansible/minio-prereqs.yml
#   Provider      MinIO (S3-compatible), not AWS
#   Endpoint      {{ minio_endpoint }}
#   Region        {{ minio_region }}
#
# Byte for byte the same shape as the file the AWS phase writes, so cluster.yml
# consumes it unchanged - only the endpoint and the credentials differ.
#
# CONTAINS LIVE MINIO SECRET KEYS. Mode 0600, gitignored. Hand it to the cluster
# admin over a channel you trust, or encrypt it in place:
#
#   ansible-vault encrypt s3-credentials.yml
#
# cluster.yml reads an encrypted file transparently with --ask-vault-pass.
# Re-running minio-prereqs.yml re-asserts the keys listed here rather than
# rotating them, so this file stays valid.
# ═══════════════════════════════════════════════════════════════════════════════
observability_s3_backends:
