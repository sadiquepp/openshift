# Where images are pushed and pulled from. Sourced by preflight.sh,
# set-registry.sh, build-push.sh and check-bases.sh so the registry is stated
# once per shell rather than repeated on four command lines:
#
#   export REGISTRY=registry.example.com:8443
#   ./preflight.sh --build-check
#   ./set-registry.sh
#   BASE=hardened ./build-push.sh
#   ./check-bases.sh
#
# REGISTRY    host[:port] of your registry. No scheme, no trailing slash, no
#             repository path -- just the host, because preflight.sh has to
#             probe https://$REGISTRY/v2/ and `podman login $REGISTRY`.
# NAMESPACE   the repository prefix under it. Defaults to online-boutique, so
#             images land at $REGISTRY/online-boutique/<service>.
# VERSION     the upstream microservices-demo release to build. Defaults to
#             v0.10.6, which is what base/kubernetes-manifests.yaml is vendored
#             from -- change both together or the manifests and images drift.
#
# Anything already set in the environment wins, and a positional argument on a
# script still beats both, so one-off overrides need no export.

: "${NAMESPACE:=online-boutique}"
: "${VERSION:=v0.10.6}"

# Strip what people paste by habit: a scheme and a trailing slash. The default
# must come first -- these scripts run under `set -u`, where expanding an unset
# REGISTRY is a fatal error rather than an empty string.
REGISTRY="${REGISTRY-}"
REGISTRY="${REGISTRY#http://}"
REGISTRY="${REGISTRY#https://}"
REGISTRY="${REGISTRY%/}"

# DEST is what the build and check scripts push to and read back.
if [ -n "${REGISTRY:-}" ]; then
  : "${DEST:=$REGISTRY/$NAMESPACE}"
fi

# Each script decides whether it needs these -- preflight.sh runs usefully with
# no registry at all, so nothing is required here.
require_registry() {
  if [ -z "${REGISTRY:-}" ] && [ -z "${DEST:-}" ]; then
    echo "error: no registry. Either:" >&2
    echo "         export REGISTRY=registry.example.com:8443" >&2
    echo "       or pass it: $1 registry.example.com:8443/$NAMESPACE" >&2
    return 1
  fi
}
