# Base-image sets for build-push.sh. Pick one with BASE=hardened|ubi.
#
# The Containerfiles take every base image as a build arg, so switching the
# whole stack from Red Hat Hardened Images to UBI 9 is a matter of a different
# set of values -- no second set of Containerfiles. That is also what makes the
# CVE comparison in cve-demo/ an apples-to-apples one: same build recipe, same
# layout, same entrypoints, different base.
#
# Override any single value from the environment; these are all defaults.
#
# Versions are chosen so the two sets line up where they can:
#   python  3.12 both sides -- UBI 9 has no 3.13/3.14, and comparing 3.14
#           against 3.12 would measure the interpreter, not the base.
#   openjdk 21 both sides -- adservice's build.gradle sets
#           sourceCompatibility = JavaVersion.VERSION_21, so 21 is enough, and
#           ubi9/openjdk-21 is what UBI 9 ships.
#   dotnet  10.0 both sides -- cartservice.csproj targets net10.0.
# Node and Go float to whatever each catalog calls current; neither service
# cares, and holding them equal is not possible across the two vendors anyway.

case "${BASE:-hardened}" in

hardened)
  # registry.access.redhat.com/hi/ -- no subscription, no pull secret.
  # Runtime variants are distroless; -builder variants carry dnf and bash.
  : "${GO_BUILDER:=registry.access.redhat.com/hi/go:latest-builder}"
  : "${GO_RUNTIME:=registry.access.redhat.com/hi/go:latest}"
  : "${NODE_BUILDER:=registry.access.redhat.com/hi/nodejs:latest-builder}"
  : "${NODE_RUNTIME:=registry.access.redhat.com/hi/nodejs:latest}"
  : "${PY_BUILDER:=registry.access.redhat.com/hi/python:3.12-builder}"
  : "${PY_RUNTIME:=registry.access.redhat.com/hi/python:3.12}"
  : "${JAVA_BUILDER:=registry.access.redhat.com/hi/openjdk:21-builder}"
  : "${JAVA_RUNTIME:=registry.access.redhat.com/hi/openjdk:21}"
  : "${DOTNET_SDK:=registry.access.redhat.com/hi/dotnet-sdk:10.0}"
  : "${DOTNET_RUNTIME:=registry.access.redhat.com/hi/dotnet-runtime:10.0}"
  : "${CACHE_IMAGE:=registry.access.redhat.com/hi/valkey:latest}"
  : "${TAG_SUFFIX:=}"
  ;;

ubi)
  # registry.access.redhat.com/ubi9/ -- also unauthenticated. The s2i builder
  # images carry a full RHEL 9 userspace; the -minimal / -runtime variants are
  # the ones meant to be shipped. Both still have a shell, unlike hardened.
  #
  # Go has no UBI runtime image -- go-toolset is a builder -- so static binaries
  # land on ubi-micro, which is the closest UBI gets to distroless.
  : "${GO_BUILDER:=registry.access.redhat.com/ubi9/go-toolset:latest}"
  : "${GO_RUNTIME:=registry.access.redhat.com/ubi9/ubi-micro:latest}"
  : "${NODE_BUILDER:=registry.access.redhat.com/ubi9/nodejs-22:latest}"
  : "${NODE_RUNTIME:=registry.access.redhat.com/ubi9/nodejs-22-minimal:latest}"
  : "${PY_BUILDER:=registry.access.redhat.com/ubi9/python-312:latest}"
  : "${PY_RUNTIME:=registry.access.redhat.com/ubi9/python-312-minimal:latest}"
  : "${JAVA_BUILDER:=registry.access.redhat.com/ubi9/openjdk-21:latest}"
  : "${JAVA_RUNTIME:=registry.access.redhat.com/ubi9/openjdk-21-runtime:latest}"
  : "${DOTNET_SDK:=registry.access.redhat.com/ubi9/dotnet-100:latest}"
  : "${DOTNET_RUNTIME:=registry.access.redhat.com/ubi9/dotnet-100-runtime:latest}"
  # UBI has no Valkey and no Redis. redis-cart keeps its upstream image on this
  # side of the comparison -- which is itself a finding worth stating out loud:
  # going all-UBI leaves one Docker Hub pull that going all-hardened does not.
  : "${CACHE_IMAGE:=docker.io/library/redis:alpine}"
  # Tag the images so both stacks can live in one registry side by side.
  : "${TAG_SUFFIX:=-ubi}"
  ;;

*)
  echo "error: BASE must be 'hardened' or 'ubi', got '${BASE}'" >&2
  return 1 2>/dev/null || exit 1
  ;;
esac
