# Online Boutique load generator (Locust) on Red Hat Hardened Images.
# Build context is src/loadgenerator in an upstream checkout.
#
# Separate from Containerfile.python because upstream's entrypoint is shell form:
#
#   ENTRYPOINT locust --host="http://${FRONTEND_ADDR}" --headless -u "${USERS:-10}" ...
#
# Shell form needs /bin/sh, and the hardened runtime images are distroless -- no
# shell, so that line cannot survive the move. Locust reads every one of those
# flags from LOCUST_* environment variables instead, so the exec-form entrypoint
# below plus env vars on the Deployment is an exact replacement. See
# ../overlays/hardened/kustomization.yaml for the matching env block.

ARG BUILDER=registry.access.redhat.com/hi/python:3.12-builder
ARG RUNTIME=registry.access.redhat.com/hi/python:3.12

FROM ${BUILDER} AS builder
# The -builder variants run as a non-root user, and a directory created by
# WORKDIR is owned by root, so an unprivileged RUN cannot write into it --
# installs, dnf, chmod and the compiler all fail with EACCES. Build stages
# therefore run as root. Nothing from this stage ships: the runtime stage below
# keeps its base image's non-root user, and OpenShift assigns its own UID from
# the namespace range regardless.
USER 0
WORKDIR /app
COPY requirements.txt ./
# --target puts every package, pure-Python and compiled alike, into one flat
# directory. NOT --prefix: RHEL and Fedora patch sysconfig so that a prefix
# install splits purelib into lib/ and platlib into lib64/, and grpcio is a
# compiled extension, so `mv .../lib/python*/site-packages` moved the pure
# packages and silently left grpc behind in lib64 -- a build that succeeded and
# then failed on `import grpc`. --target also means no python3.X directory name
# in any path, so nothing downstream has to know the interpreter version.
# Optional constraints. The application layer is where every actionable finding
# lives, and most of them are transitive pins in upstream's requirements.txt --
# pyasn1 arriving via google-auth, for example. Editing that file forks
# upstream; a constraints file does not. Put desired minimums in
# constraints.txt next to this Containerfile:
#
#   urllib3>=2.7.1
#   pyasn1>=0.6.4
#   setuptools>=78.1.1
#
# and pass CONSTRAINTS=constraints.txt. pip then resolves transitive
# dependencies subject to those floors. Absent or unset, nothing changes --
# this is opt-in, and the build is identical without it.
#
# It is a floor, not a guarantee: a constraint that conflicts with what the
# application genuinely requires fails the build, which is the correct outcome
# and better than discovering the incompatibility at runtime.
ARG CONSTRAINTS=
RUN python3 -m pip install --no-cache-dir --target=/app/site-packages \
      ${CONSTRAINTS:+-c "${CONSTRAINTS}"} -r requirements.txt
COPY locustfile.py ./
RUN chmod -R a+rX /app

FROM ${RUNTIME}
WORKDIR /app
COPY --from=builder /app /app
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/site-packages \
    GEVENT_SUPPORT=True \
    LOCUST_LOCUSTFILE=/app/locustfile.py \
    LOCUST_HEADLESS=true
# `python -m locust` rather than the console script: pip wrote that script with a
# shebang pointing at the builder's interpreter path.
ENTRYPOINT ["python3", "-m", "locust"]
